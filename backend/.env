DATABASE_URL="postgresql://postgres:123@localhost:5433/memory_map?schema=public"
JWT_SECRET="your-secret-key-change-in-production"
JWT_EXPIRATION="7d"
PORT=3001

# ─────────────────────────────────────────────────
# Email / SMTP Configuration
# Để trống → dùng console.log thay thế (dev mode)
# Điền đầy đủ → gửi email thật qua SMTP
# ─────────────────────────────────────────────────
# Gmail example:
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USER=youraddress@gmail.com
#   MAIL_PASS=xxxx xxxx xxxx xxxx   ← App Password (không phải mật khẩu Gmail)
#
# Hướng dẫn tạo App Password Gmail:
#   https://myaccount.google.com/apppasswords
# ─────────────────────────────────────────────────
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM_NAME=Memory Map
