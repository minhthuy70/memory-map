generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                  @id @default(uuid())
  email                   String                  @unique
  passwordHash            String?                 @map("password_hash")
  name                    String?
  avatar                  String?
  createdAt               DateTime                @default(now()) @map("created_at")
  updatedAt               DateTime                @updatedAt @map("updated_at")
  lockedUntil             DateTime?               @map("locked_until")
  loginAttempts           Int                     @default(0) @map("login_attempts")
  isActive                Boolean                 @default(true) @map("is_active")
  lastLoginAt             DateTime?               @map("last_login_at")
  facebookId              String?                 @unique @map("facebook_id")
  googleId                String?                 @unique @map("google_id")
  isEmailVerified         Boolean                 @default(false) @map("is_email_verified")
  verificationCode        String?                 @map("verification_code")
  verificationExpires     DateTime?               @map("verification_expires")
  resetPasswordExpires    DateTime?               @map("reset_password_expires")
  resetPasswordToken      String?                 @unique @map("reset_password_token")
  pendingEmail            String?                 @map("pending_email")
  twoFactorEnabled        Boolean                 @default(false) @map("two_factor_enabled")
  twoFactorSecret         String?                 @map("two_factor_secret")
  twoFactorTempSecret     String?                 @map("two_factor_temp_secret")
  twoFactorBackupCodes    String[]                @default([]) @map("two_factor_backup_codes")
  twoFactorLastUsed       DateTime?               @map("two_factor_last_used")
  biometricEnabled        Boolean                 @default(false) @map("biometric_enabled")
  webauthnCredentials     WebAuthnCredential[]
  memories                Memory[]
  sessions                Session[]
  liveJourneyBroadcasts   LiveJourneyBroadcast[]
  virtualWatchParties     VirtualWatchParty[]
  eventGuestWalls         EventGuestWall[]
  temporarySharedLinks    TemporarySharedLink[]
  travelPortfolios        TravelPortfolio[]
  embeddableMapWidgets    EmbeddableMapWidget[]
  qrCodeStickers          QRCodeSticker[]
  verticalStoryExports    VerticalStoryExport[]
  friendVoiceCommentaries FriendVoiceCommentary[]

  // Hybrid Cloud & Offline-First
  offlineSyncStates  OfflineSyncState[]
  nasBackups         NASBackup[]
  vaultExports       VaultExport[]
  p2pSyncSessions    P2PSyncSession[]
  userWidgets        UserWidget[]
  watchComplications WatchComplication[]
  carIntegrations    CarIntegration[]
  clipboardSyncs     ClipboardSync[]

  // AI Multi-agent Companion
  aiJournalEntries      AIJournalEntry[]
  aiInterviews          AIInterview[]
  photoCurations        PhotoCuration[]
  semanticSearchIndices SemanticSearchIndex[]
  voiceCloneModels      VoiceCloneModel[]
  memorySyntheses       MemorySynthesis[]

  // Advanced Privacy & Vault
  vaultMemories   VaultMemory[]
  auditLogs       AuditLog[]
  duressPasswords DuressPassword[]
  vaultAccessLogs VaultAccessLog[]

  // Gamification & Geo-exploration
  userStats          UserStats?
  badges             Badge[]
  journalingStreaks  JournalingStreak?
  passportStamps     PassportStamp[]
  geoCaches          GeoCache[]         @relation("GeoCacheCreator")
  geoCacheLogs       GeoCacheLog[]
  bingoCompletions   BingoCompletion[]
  leaderboardEntries LeaderboardEntry[]
  virtualSouvenirs   VirtualSouvenir[]

  @@map("users")
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  icon      String
  createdAt DateTime @default(now()) @map("created_at")
  color     String   @default("#6366f1")
  memories  Memory[]

  @@map("categories")
}

model Memory {
  id              String        @id @default(uuid())
  userId          String        @map("user_id")
  title           String
  content         String?
  latitude        Float
  longitude       Float
  locationName    String?       @map("location_name")
  memoryDate      DateTime      @map("memory_date")
  mood            Mood
  categoryId      String        @map("category_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  reminderDate    DateTime?     @map("reminder_date")
  reminderSent    Boolean       @default(false) @map("reminder_sent")
  isPublic        Boolean       @default(false) @map("is_public")
  publicExpiresAt DateTime?     @map("public_expires_at")
  publicSlug      String?       @unique @map("public_slug")
  category        Category      @relation(fields: [categoryId], references: [id])
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  images          MemoryImage[]

  @@index([userId])
  @@index([categoryId])
  @@index([mood])
  @@index([reminderDate])
  @@index([publicSlug])
  @@map("memories")
}

model MemoryImage {
  id        String   @id @default(uuid())
  memoryId  String   @map("memory_id")
  imageUrl  String   @map("image_url")
  createdAt DateTime @default(now()) @map("created_at")
  order     Int      @default(0)
  memory    Memory   @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@index([memoryId])
  @@index([memoryId, order])
  @@map("memory_images")
}

model Session {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  token        String   @unique
  deviceInfo   String?  @map("device_info")
  ipAddress    String?  @map("ip_address")
  lastActivity DateTime @default(now()) @map("last_activity")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("sessions")
}

enum Mood {
  HAPPY
  SAD
  EXCITED
  PEACEFUL
  NOSTALGIC
  LOVE
  ANGRY
  TIRED
  NEUTRAL
}

model WebAuthnCredential {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  credentialId String    @unique @map("credential_id")
  publicKey    Bytes     @map("public_key")
  counter      BigInt    @default(0)
  deviceType   String    @default("singleDevice") @map("device_type")
  backedUp     Boolean   @default(false) @map("backed_up")
  transports   String[]  @default([])
  deviceName   String?   @map("device_name")
  createdAt    DateTime  @default(now()) @map("created_at")
  lastUsedAt   DateTime? @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("webauthn_credentials")
}

// Live Journey Broadcast
model LiveJourneyBroadcast {
  id              String                @id @default(uuid())
  userId          String                @map("user_id")
  title           String
  isActive        Boolean               @default(true) @map("is_active")
  password        String?
  batteryLevel    Int?                  @map("battery_level")
  elevation       Float?
  beaconMode      Boolean               @default(false) @map("beacon_mode")
  startedAt       DateTime              @default(now()) @map("started_at")
  endedAt         DateTime?             @map("ended_at")
  locationUpdates LiveJourneyLocation[]
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
  @@map("live_journey_broadcasts")
}

model LiveJourneyLocation {
  id          String               @id @default(uuid())
  broadcastId String               @map("broadcast_id")
  latitude    Float
  longitude   Float
  timestamp   DateTime             @default(now())
  broadcast   LiveJourneyBroadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  @@index([broadcastId])
  @@index([timestamp])
  @@map("live_journey_locations")
}

// Virtual Watch Party
model VirtualWatchParty {
  id           String                         @id @default(uuid())
  userId       String                         @map("user_id")
  title        String
  isActive     Boolean                        @default(true) @map("is_active")
  roomCode     String                         @unique
  createdAt    DateTime                       @default(now()) @map("created_at")
  endedAt      DateTime?                      @map("ended_at")
  participants VirtualWatchPartyParticipant[]
  memoryId     String?                        @map("memory_id")
  user         User                           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([roomCode])
  @@index([isActive])
  @@map("virtual_watch_parties")
}

model VirtualWatchPartyParticipant {
  id       String            @id @default(uuid())
  partyId  String            @map("party_id")
  userId   String            @map("user_id")
  joinedAt DateTime          @default(now()) @map("joined_at")
  party    VirtualWatchParty @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([partyId])
  @@index([userId])
  @@map("virtual_watch_party_participants")
}

// Event Guest Wall
model EventGuestWall {
  id            String                   @id @default(uuid())
  userId        String                   @map("user_id")
  title         String
  eventType     String                   @map("event_type")
  eventDate     DateTime                 @map("event_date")
  qrCode        String                   @map("qr_code")
  isActive      Boolean                  @default(true) @map("is_active")
  createdAt     DateTime                 @default(now()) @map("created_at")
  contributions EventGuestContribution[]
  user          User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
  @@map("event_guest_walls")
}

model EventGuestContribution {
  id        String         @id @default(uuid())
  wallId    String         @map("wall_id")
  guestName String         @map("guest_name")
  message   String?
  imageUrl  String?        @map("image_url")
  createdAt DateTime       @default(now()) @map("created_at")
  wall      EventGuestWall @relation(fields: [wallId], references: [id], onDelete: Cascade)

  @@index([wallId])
  @@index([createdAt])
  @@map("event_guest_contributions")
}

// Temporary Shared Links
model TemporarySharedLink {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  memoryId  String?  @map("memory_id")
  title     String
  url       String   @unique
  passcode  String?
  maxViews  Int?     @map("max_views")
  viewCount Int      @default(0) @map("view_count")
  expiresAt DateTime @map("expires_at")
  isRevoked Boolean  @default(false) @map("is_revoked")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([memoryId])
  @@index([expiresAt])
  @@map("temporary_shared_links")
}

// Travel Portfolio
model TravelPortfolio {
  id               String                  @id @default(uuid())
  userId           String                  @map("user_id")
  customDomain     String?                 @map("custom_domain")
  title            String
  bio              String?
  isPublic         Boolean                 @default(true) @map("is_public")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")
  featuredMemories TravelPortfolioMemory[]
  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([customDomain])
  @@map("travel_portfolios")
}

model TravelPortfolioMemory {
  id          String          @id @default(uuid())
  portfolioId String          @map("portfolio_id")
  memoryId    String          @map("memory_id")
  order       Int             @default(0)
  isFeatured  Boolean         @default(false) @map("is_featured")
  portfolio   TravelPortfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
  @@index([memoryId])
  @@map("travel_portfolio_memories")
}

// Embeddable Map Widget
model EmbeddableMapWidget {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  title        String
  widgetId     String   @unique @map("widget_id")
  theme        String   @default("light")
  showControls Boolean  @default(true) @map("show_controls")
  showLabels   Boolean  @default(true) @map("show_labels")
  customCSS    String?  @map("custom_css")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([widgetId])
  @@map("embeddable_map_widgets")
}

// QR Code Stickers
model QRCodeSticker {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  memoryId    String   @map("memory_id")
  stickerCode String   @unique @map("sticker_code")
  qrCodeUrl   String   @map("qr_code_url")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  scansCount  Int      @default(0) @map("scans_count")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([memoryId])
  @@index([stickerCode])
  @@map("qr_code_stickers")
}

// Vertical Story Export
model VerticalStoryExport {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  memoryId    String    @map("memory_id")
  videoUrl    String?   @map("video_url")
  resolution  String    @default("1080p")
  format      String    @default("mp4")
  duration    Int?
  status      String    @default("pending")
  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([memoryId])
  @@index([status])
  @@map("vertical_story_exports")
}

// Friend Voice Commentary
model FriendVoiceCommentary {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  memoryId        String   @map("memory_id")
  commentatorName String   @map("commentator_name")
  audioUrl        String   @map("audio_url")
  duration        Int?
  createdAt       DateTime @default(now()) @map("created_at")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([memoryId])
  @@map("friend_voice_commentaries")
}

// Hybrid Cloud & Offline-First
model OfflineSyncState {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  entityType String    @map("entity_type") // memory, image, etc
  entityId   String    @map("entity_id")
  operation  String // create, update, delete
  data       String    @map("data") // JSON payload
  createdAt  DateTime  @default(now()) @map("created_at")
  syncedAt   DateTime? @map("synced_at")
  isSynced   Boolean   @default(false) @map("is_synced")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([isSynced])
  @@map("offline_sync_states")
}

model NASBackup {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  provider     String // webdav, s3, dropbox, onedrive
  backupPath   String    @map("backup_path")
  backupSize   BigInt    @map("backup_size")
  lastBackupAt DateTime? @map("last_backup_at")
  schedule     String    @default("daily") // daily, weekly, monthly
  isActive     Boolean   @default(true) @map("is_active")
  status       String    @default("idle") // idle, running, success, failed
  errorMessage String?   @map("error_message")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([provider])
  @@index([isActive])
  @@map("nas_backups")
}

model VaultExport {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  fileName      String    @map("file_name")
  filePath      String    @map("file_path")
  fileSize      BigInt    @map("file_size")
  exportDate    DateTime  @default(now()) @map("export_date")
  expiresAt     DateTime? @map("expires_at")
  downloadCount Int       @default(0) @map("download_count")
  isPublic      Boolean   @default(false) @map("is_public")
  accessCode    String?   @unique @map("access_code")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([accessCode])
  @@map("vault_exports")
}

model P2PSyncSession {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  sessionId   String   @unique @map("session_id")
  peerAddress String   @map("peer_address")
  peerName    String?  @map("peer_name")
  isConnected Boolean  @default(false) @map("is_connected")
  lastSeen    DateTime @default(now()) @map("last_seen")
  syncCount   Int      @default(0) @map("sync_count")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@index([isConnected])
  @@map("p2p_sync_sessions")
}

model UserWidget {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  widgetType String   @map("widget_type") // ios, android, desktop
  widgetId   String   @map("widget_id")
  widgetName String   @map("widget_name")
  config     String   @map("config") // JSON config
  isEnabled  Boolean  @default(true) @map("is_enabled")
  position   Int      @default(0) @map("position")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([widgetType])
  @@map("user_widgets")
}

model WatchComplication {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  complicationType String   @map("complication_type") // apple, wearos
  complicationId   String   @map("complication_id")
  action           String   @map("action") // audio-memo, heart-rate, coordinate, step-count
  isEnabled        Boolean  @default(true) @map("is_enabled")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([complicationType])
  @@map("watch_complications")
}

model CarIntegration {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  carType         String   @map("car_type") // apple, android
  integrationType String   @map("integration_type") // carplay, android-auto
  deviceId        String   @map("device_id")
  isEnabled       Boolean  @default(true) @map("is_enabled")
  autoPlay        Boolean  @default(false) @map("auto_play")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([carType])
  @@map("car_integrations")
}

model ClipboardSync {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  clipboardId  String   @unique @map("clipboard_id")
  dataType     String   @map("data_type") // location, photo, text
  data         String   @map("data") // JSON payload
  sourceDevice String   @map("source_device")
  expiresAt    DateTime @default(now()) @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([clipboardId])
  @@index([expiresAt])
  @@map("clipboard_syncs")
}

// AI Multi-agent Companion
model AIJournalEntry {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  memoryId    String?  @map("memory_id")
  date        DateTime @map("date")
  title       String
  content     String   @db.Text
  photos      String   @map("photos") // JSON array of photo URLs
  locations   String   @map("locations") // JSON array of location data
  isDraft     Boolean  @default(true) @map("is_draft")
  isReviewed  Boolean  @default(false) @map("is_reviewed")
  generatedAt DateTime @default(now()) @map("generated_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
  @@index([isDraft])
  @@map("ai_journal_entries")
}

model AIInterview {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  question    String    @db.Text
  answer      String?   @db.Text
  audioUrl    String?   @map("audio_url")
  duration    Int?
  isCompleted Boolean   @default(false) @map("is_completed")
  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isCompleted])
  @@map("ai_interviews")
}

model PhotoCuration {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  memoryId       String   @map("memory_id")
  photoId        String   @map("photo_id")
  aestheticScore Float    @map("aesthetic_score")
  focusScore     Float    @map("focus_score")
  smileScore     Float    @map("smile_score")
  overallScore   Float    @map("overall_score")
  isHighlighted  Boolean  @default(false) @map("is_highlighted")
  isRejected     Boolean  @default(false) @map("is_rejected")
  reasons        String?  @map("reasons") // JSON array of rejection reasons
  createdAt      DateTime @default(now()) @map("created_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([memoryId])
  @@index([overallScore])
  @@map("photo_curations")
}

model SemanticSearchIndex {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  entityType String   @map("entity_type") // memory, image
  entityId   String   @map("entity_id")
  embedding  String   @map("embedding") // Vector embedding as JSON array
  metadata   String   @map("metadata") // JSON metadata
  indexedAt  DateTime @default(now()) @map("indexed_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([entityType, entityId])
  @@map("semantic_search_indices")
}

model VoiceCloneModel {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  modelName        String    @map("model_name")
  sampleAudioUrl   String    @map("sample_audio_url")
  modelPath        String    @map("model_path")
  status           String    @default("training") // training, ready, failed
  trainingProgress Int       @default(0) @map("training_progress")
  errorMessage     String?   @map("error_message")
  createdAt        DateTime  @default(now()) @map("created_at")
  readyAt          DateTime? @map("ready_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("voice_clone_models")
}

model MemorySynthesis {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  title          String
  description    String    @db.Text
  participantIds String    @map("participant_ids") // JSON array of user IDs
  memoryIds      String    @map("memory_ids") // JSON array of memory IDs
  chapters       String    @map("chapters") // JSON array of chapter data
  tone           String    @default("neutral") // humorous, poetic, adventurous, neutral
  status         String    @default("pending") // pending, processing, completed, failed
  generatedAt    DateTime? @map("generated_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("memory_syntheses")
}

// Advanced Privacy & Vault
model VaultMemory {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  memoryId      String    @map("memory_id")
  vaultType     String    @map("vault_type") // standard, double-lock, ephemeral
  encryptionKey String?   @map("encryption_key")
  isEncrypted   Boolean   @default(false) @map("is_encrypted")
  viewCount     Int       @default(0) @map("view_count")
  maxViews      Int?      @map("max_views")
  expiresAt     DateTime? @map("expires_at")
  isDestroyed   Boolean   @default(false) @map("is_destroyed")
  destroyedAt   DateTime? @map("destroyed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([memoryId])
  @@index([vaultType])
  @@index([isDestroyed])
  @@map("vault_memories")
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  action       String // login, export, edit, view, vault_access
  entityType   String   @map("entity_type") // memory, image, vault
  entityId     String?  @map("entity_id")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  metadata     String?  @map("metadata") // JSON metadata
  previousHash String?  @map("previous_hash") // For cryptographic chain
  currentHash  String   @map("current_hash") // SHA-256 hash
  createdAt    DateTime @default(now()) @map("created_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([currentHash])
  @@map("audit_logs")
}

model DuressPassword {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  passwordHash  String    @map("password_hash")
  isEmergency   Boolean   @default(false) @map("is_emergency")
  alertSent     Boolean   @default(false) @map("alert_sent")
  alertContacts String    @map("alert_contacts") // JSON array of contact info
  lastUsedAt    DateTime? @map("last_used_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isEmergency])
  @@map("duress_passwords")
}

model VaultAccessLog {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  vaultMemoryId String   @map("vault_memory_id")
  accessMethod  String   @map("access_method") // biometric, password, both
  success       Boolean
  failureReason String?  @map("failure_reason")
  ipAddress     String?  @map("ip_address")
  createdAt     DateTime @default(now()) @map("created_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([vaultMemoryId])
  @@index([success])
  @@index([createdAt])
  @@map("vault_access_logs")
}

// Gamification & Geo-exploration
model UserStats {
  id               String   @id @default(uuid())
  userId           String   @unique @map("user_id")
  xp               Int      @default(0)
  level            Int      @default(1)
  totalMemories    Int      @default(0) @map("total_memories")
  totalPhotos      Int      @default(0) @map("total_photos")
  totalDistance    Int      @default(0) @map("total_distance") // in meters
  locationsVisited Int      @default(0) @map("locations_visited")
  streakDays       Int      @default(0) @map("streak_days")
  longestStreak    Int      @default(0) @map("longest_streak")
  updatedAt        DateTime @updatedAt @map("updated_at")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([level])
  @@map("user_stats")
}

model Badge {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  badgeType  String    @map("badge_type") // coffee_connoisseur, island_hopper, summit_seeker
  badgeName  String    @map("badge_name")
  rarity     String    @default("bronze") // bronze, silver, gold, platinum
  progress   Int       @default(0)
  target     Int
  unlockedAt DateTime? @map("unlocked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([badgeType])
  @@index([rarity])
  @@map("badges")
}

model JournalingStreak {
  id              String    @id @default(uuid())
  userId          String    @unique @map("user_id")
  currentStreak   Int       @default(0) @map("current_streak")
  longestStreak   Int       @default(0) @map("longest_streak")
  lastJournalDate DateTime? @map("last_journal_date")
  freezeTokens    Int       @default(0) @map("freeze_tokens")
  milestones      String    @map("milestones") // JSON array of milestone dates
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("journaling_streaks")
}

model PassportStamp {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  country     String
  city        String
  province    String
  stampDate   DateTime @default(now()) @map("stamp_date")
  stampDesign String   @map("stamp_design") // vintage design name
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([country])
  @@index([city])
  @@map("passport_stamps")
}

model GeoCache {
  id          String   @id @default(uuid())
  creatorId   String   @map("creator_id")
  name        String
  description String   @db.Text
  latitude    Float
  longitude   Float
  difficulty  Int      @default(1) // 1-5
  hint        String?
  riddle      String?
  isHidden    Boolean  @default(false) @map("is_hidden")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  creator     User     @relation("GeoCacheCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId])
  @@index([latitude, longitude])
  @@map("geo_caches")
}

model GeoCacheLog {
  id         String   @id @default(uuid())
  geoCacheId String   @map("geo_cache_id")
  userId     String   @map("user_id")
  logMessage String   @map("log_message")
  foundAt    DateTime @default(now()) @map("found_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([geoCacheId])
  @@index([userId])
  @@map("geo_cache_logs")
}

model BingoChallenge {
  id         String   @id @default(uuid())
  year       Int
  challenges String   @map("challenges") // JSON array of 25 challenges
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([year])
  @@index([isActive])
  @@map("bingo_challenges")
}

model BingoCompletion {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  challengeId      String    @map("challenge_id")
  completedIndices String    @map("completed_indices") // JSON array of completed indices (0-24)
  completedAt      DateTime? @map("completed_at")
  rewardClaimed    Boolean   @default(false) @map("reward_claimed")
  createdAt        DateTime  @default(now()) @map("created_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, challengeId])
  @@index([userId])
  @@index([challengeId])
  @@map("bingo_completions")
}

model Leaderboard {
  id        String   @id @default(uuid())
  name      String
  type      String // friends, global, monthly
  metric    String // total_km, provinces_unlocked, steps_taken
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([type])
  @@map("leaderboards")
}

model LeaderboardEntry {
  id            String   @id @default(uuid())
  leaderboardId String   @map("leaderboard_id")
  userId        String   @map("user_id")
  score         Float
  rank          Int
  period        String   @default("all_time") // all_time, monthly, weekly
  updatedAt     DateTime @updatedAt @map("updated_at")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([leaderboardId])
  @@index([userId])
  @@index([rank])
  @@map("leaderboard_entries")
}

model VirtualSouvenir {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  name        String
  type        String // figurine, postcard, magnet, keychain
  location    String
  unlockedAt  DateTime @default(now()) @map("unlocked_at")
  isDisplayed Boolean  @default(true) @map("is_displayed")
  position    Int      @default(0) // position on shelf
  metadata    String?  @map("metadata") // JSON metadata (3D model path, color, etc)
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@map("virtual_souvenirs")
}
