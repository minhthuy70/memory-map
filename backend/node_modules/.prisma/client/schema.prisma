generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                  @id @default(uuid())
  email                   String                  @unique
  passwordHash            String?                 @map("password_hash")
  name                    String?
  avatar                  String?
  createdAt               DateTime                @default(now()) @map("created_at")
  updatedAt               DateTime                @updatedAt @map("updated_at")
  lockedUntil             DateTime?               @map("locked_until")
  loginAttempts           Int                     @default(0) @map("login_attempts")
  isActive                Boolean                 @default(true) @map("is_active")
  lastLoginAt             DateTime?               @map("last_login_at")
  facebookId              String?                 @unique @map("facebook_id")
  googleId                String?                 @unique @map("google_id")
  isEmailVerified         Boolean                 @default(false) @map("is_email_verified")
  verificationCode        String?                 @map("verification_code")
  verificationExpires     DateTime?               @map("verification_expires")
  resetPasswordExpires    DateTime?               @map("reset_password_expires")
  resetPasswordToken      String?                 @unique @map("reset_password_token")
  pendingEmail            String?                 @map("pending_email")
  twoFactorEnabled        Boolean                 @default(false) @map("two_factor_enabled")
  twoFactorSecret         String?                 @map("two_factor_secret")
  twoFactorTempSecret     String?                 @map("two_factor_temp_secret")
  twoFactorBackupCodes    String[]                @default([]) @map("two_factor_backup_codes")
  twoFactorLastUsed       DateTime?               @map("two_factor_last_used")
  biometricEnabled        Boolean                 @default(false) @map("biometric_enabled")
  webauthnCredentials     WebAuthnCredential[]
  memories                Memory[]
  sessions                Session[]
  liveJourneyBroadcasts   LiveJourneyBroadcast[]
  virtualWatchParties     VirtualWatchParty[]
  eventGuestWalls         EventGuestWall[]
  temporarySharedLinks    TemporarySharedLink[]
  travelPortfolios        TravelPortfolio[]
  embeddableMapWidgets    EmbeddableMapWidget[]
  qrCodeStickers          QRCodeSticker[]
  verticalStoryExports    VerticalStoryExport[]
  friendVoiceCommentaries FriendVoiceCommentary[]

  // Hybrid Cloud & Offline-First
  offlineSyncStates    OfflineSyncState[]
  nasBackups           NASBackup[]
  vaultExports         VaultExport[]
  p2pSyncSessions      P2PSyncSession[]
  userWidgets          UserWidget[]
  watchComplications   WatchComplication[]
  carIntegrations      CarIntegration[]
  clipboardSyncs       ClipboardSync[]
  desktopApps          DesktopApp[]
  wildernessDataSavers WildernessDataSaver[]

  // AI Multi-agent Companion
  aiJournalEntries       AIJournalEntry[]
  aiInterviews           AIInterview[]
  photoCurations         PhotoCuration[]
  semanticSearchIndices  SemanticSearchIndex[]
  voiceCloneModels       VoiceCloneModel[]
  memorySyntheses        MemorySynthesis[]
  travelNarrations       TravelNarration[]
  historicalSimulations  HistoricalSimulation[]
  ageProgressions        AgeProgression[]
  predictiveResurfacings PredictiveResurfacing[]

  // Advanced Privacy & Vault
  vaultMemories         VaultMemory[]
  auditLogs             AuditLog[]
  duressPasswords       DuressPassword[]
  vaultAccessLogs       VaultAccessLog[]
  calculatorCamouflages CalculatorCamouflage[]
  zeroKnowledgeE2EEs    ZeroKnowledgeE2EE[]
  exifSanitizers        ExifSanitizer[]
  screenshotPreventions ScreenshotPrevention[]

  // Gamification & Geo-exploration
  userStats                UserStats?
  badges                   Badge[]
  journalingStreaks        JournalingStreak?
  passportStamps           PassportStamp[]
  bingoCompletions         BingoCompletion[]
  virtualSouvenirs         VirtualSouvenir[]
  fogOfWarMaps             FogOfWarMap[]
  geocaches                Geocache[]
  geocacheLogs             GeocacheLog[]
  arTreasureChests         ARTreasureChest[]
  travelLeaderboardEntries TravelLeaderboardEntry[]

  // Psychology & Mindfulness
  emotionalGeographyPoints    EmotionalGeographyPoint[]
  gratitudeEntries            GratitudeEntry[]
  resilienceMoments           ResilienceMoment[]
  reminiscenceTherapySessions ReminiscenceTherapySession[]
  innerChildDialogues         InnerChildDialogue[]
  binauralSoundTherapies      BinauralSoundTherapy[]
  zenReflectionMode           ZenReflectionMode?
  emotionalWaveforms          EmotionalWaveform[]
  dreamJournals               DreamJournal[]
  dailySerendipities          DailySerendipity[]

  // Genealogy & Time Travel
  timeLockedCapsules      TimeLockedCapsule[]
  geofencedCapsules       GeofencedCapsule[]
  legacyLetters           LegacyLetter[]
  digitalMemorials        DigitalMemorial[]
  familyHeirlooms         FamilyHeirloom[]
  familyRecipes           FamilyRecipe[]
  familyMembers           FamilyMember[]
  ancestralMigrations     AncestralMigration[]
  oralHistories           OralHistory[]
  generationalComparisons GenerationalComparison[]

  // Audiovisual Creative Studio
  scrapbookProjects ScrapbookProject[]
  soundscapeMixes   SoundscapeMix[]

  // Advanced Trip Planning
  itineraries     Itinerary[]
  tripExpenses    TripExpense[]
  packingLists    PackingList[]
  travelDocuments TravelDocument[]

  // Social & Community
  memoryReactions   MemoryReaction[]
  memoryComments    MemoryComment[]
  memoryCircles     MemoryCircle[]
  albumContributors AlbumContributor[]
  circleMembers     CircleMember[]

  @@map("users")
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  icon      String
  createdAt DateTime @default(now()) @map("created_at")
  color     String   @default("#6366f1")
  memories  Memory[]

  @@map("categories")
}

model Memory {
  id              String        @id @default(uuid())
  userId          String        @map("user_id")
  title           String
  content         String?
  latitude        Float
  longitude       Float
  locationName    String?       @map("location_name")
  memoryDate      DateTime      @map("memory_date")
  mood            Mood
  categoryId      String        @map("category_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  reminderDate    DateTime?     @map("reminder_date")
  reminderSent    Boolean       @default(false) @map("reminder_sent")
  isPublic        Boolean       @default(false) @map("is_public")
  publicExpiresAt DateTime?     @map("public_expires_at")
  publicSlug      String?       @unique @map("public_slug")
  category        Category      @relation(fields: [categoryId], references: [id])
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  images          MemoryImage[]

  @@index([userId])
  @@index([categoryId])
  @@index([mood])
  @@index([reminderDate])
  @@index([publicSlug])
  @@map("memories")
}

model MemoryImage {
  id        String   @id @default(uuid())
  memoryId  String   @map("memory_id")
  imageUrl  String   @map("image_url")
  createdAt DateTime @default(now()) @map("created_at")
  order     Int      @default(0)
  memory    Memory   @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@index([memoryId])
  @@index([memoryId, order])
  @@map("memory_images")
}

model Session {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  token        String   @unique
  deviceInfo   String?  @map("device_info")
  ipAddress    String?  @map("ip_address")
  lastActivity DateTime @default(now()) @map("last_activity")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("sessions")
}

enum Mood {
  HAPPY
  SAD
  EXCITED
  PEACEFUL
  NOSTALGIC
  LOVE
  ANGRY
  TIRED
  NEUTRAL
}

model WebAuthnCredential {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  credentialId String    @unique @map("credential_id")
  publicKey    Bytes     @map("public_key")
  counter      BigInt    @default(0)
  deviceType   String    @default("singleDevice") @map("device_type")
  backedUp     Boolean   @default(false) @map("backed_up")
  transports   String[]  @default([])
  deviceName   String?   @map("device_name")
  createdAt    DateTime  @default(now()) @map("created_at")
  lastUsedAt   DateTime? @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("webauthn_credentials")
}

// Live Journey Broadcast
model LiveJourneyBroadcast {
  id              String                @id @default(uuid())
  userId          String                @map("user_id")
  title           String
  isActive        Boolean               @default(true) @map("is_active")
  password        String?
  batteryLevel    Int?                  @map("battery_level")
  elevation       Float?
  beaconMode      Boolean               @default(false) @map("beacon_mode")
  startedAt       DateTime              @default(now()) @map("started_at")
  endedAt         DateTime?             @map("ended_at")
  locationUpdates LiveJourneyLocation[]
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
  @@map("live_journey_broadcasts")
}

model LiveJourneyLocation {
  id          String               @id @default(uuid())
  broadcastId String               @map("broadcast_id")
  latitude    Float
  longitude   Float
  timestamp   DateTime             @default(now())
  broadcast   LiveJourneyBroadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  @@index([broadcastId])
  @@index([timestamp])
  @@map("live_journey_locations")
}

// Virtual Watch Party
model VirtualWatchParty {
  id           String                         @id @default(uuid())
  userId       String                         @map("user_id")
  title        String
  isActive     Boolean                        @default(true) @map("is_active")
  roomCode     String                         @unique
  createdAt    DateTime                       @default(now()) @map("created_at")
  endedAt      DateTime?                      @map("ended_at")
  participants VirtualWatchPartyParticipant[]
  memoryId     String?                        @map("memory_id")
  user         User                           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([roomCode])
  @@index([isActive])
  @@map("virtual_watch_parties")
}

model VirtualWatchPartyParticipant {
  id       String            @id @default(uuid())
  partyId  String            @map("party_id")
  userId   String            @map("user_id")
  joinedAt DateTime          @default(now()) @map("joined_at")
  party    VirtualWatchParty @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([partyId])
  @@index([userId])
  @@map("virtual_watch_party_participants")
}

// Event Guest Wall
model EventGuestWall {
  id            String                   @id @default(uuid())
  userId        String                   @map("user_id")
  title         String
  eventType     String                   @map("event_type")
  eventDate     DateTime                 @map("event_date")
  qrCode        String                   @map("qr_code")
  isActive      Boolean                  @default(true) @map("is_active")
  createdAt     DateTime                 @default(now()) @map("created_at")
  contributions EventGuestContribution[]
  user          User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
  @@map("event_guest_walls")
}

model EventGuestContribution {
  id        String         @id @default(uuid())
  wallId    String         @map("wall_id")
  guestName String         @map("guest_name")
  message   String?
  imageUrl  String?        @map("image_url")
  createdAt DateTime       @default(now()) @map("created_at")
  wall      EventGuestWall @relation(fields: [wallId], references: [id], onDelete: Cascade)

  @@index([wallId])
  @@index([createdAt])
  @@map("event_guest_contributions")
}

// Temporary Shared Links
model TemporarySharedLink {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  memoryId  String?  @map("memory_id")
  title     String
  url       String   @unique
  passcode  String?
  maxViews  Int?     @map("max_views")
  viewCount Int      @default(0) @map("view_count")
  expiresAt DateTime @map("expires_at")
  isRevoked Boolean  @default(false) @map("is_revoked")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([memoryId])
  @@index([expiresAt])
  @@map("temporary_shared_links")
}

// Travel Portfolio
model TravelPortfolio {
  id               String                  @id @default(uuid())
  userId           String                  @map("user_id")
  customDomain     String?                 @map("custom_domain")
  title            String
  bio              String?
  isPublic         Boolean                 @default(true) @map("is_public")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")
  featuredMemories TravelPortfolioMemory[]
  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([customDomain])
  @@map("travel_portfolios")
}

model TravelPortfolioMemory {
  id          String          @id @default(uuid())
  portfolioId String          @map("portfolio_id")
  memoryId    String          @map("memory_id")
  order       Int             @default(0)
  isFeatured  Boolean         @default(false) @map("is_featured")
  portfolio   TravelPortfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
  @@index([memoryId])
  @@map("travel_portfolio_memories")
}

// Embeddable Map Widget
model EmbeddableMapWidget {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  title        String
  widgetId     String   @unique @map("widget_id")
  theme        String   @default("light")
  showControls Boolean  @default(true) @map("show_controls")
  showLabels   Boolean  @default(true) @map("show_labels")
  customCSS    String?  @map("custom_css")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([widgetId])
  @@map("embeddable_map_widgets")
}

// QR Code Stickers
model QRCodeSticker {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  memoryId    String   @map("memory_id")
  stickerCode String   @unique @map("sticker_code")
  qrCodeUrl   String   @map("qr_code_url")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  scansCount  Int      @default(0) @map("scans_count")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([memoryId])
  @@index([stickerCode])
  @@map("qr_code_stickers")
}

// Vertical Story Export
model VerticalStoryExport {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  memoryId    String    @map("memory_id")
  videoUrl    String?   @map("video_url")
  resolution  String    @default("1080p")
  format      String    @default("mp4")
  duration    Int?
  status      String    @default("pending")
  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([memoryId])
  @@index([status])
  @@map("vertical_story_exports")
}

// Friend Voice Commentary
model FriendVoiceCommentary {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  memoryId        String   @map("memory_id")
  commentatorName String   @map("commentator_name")
  audioUrl        String   @map("audio_url")
  duration        Int?
  createdAt       DateTime @default(now()) @map("created_at")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([memoryId])
  @@map("friend_voice_commentaries")
}

// Hybrid Cloud & Offline-First
model OfflineSyncState {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  entityType String    @map("entity_type") // memory, image, etc
  entityId   String    @map("entity_id")
  operation  String // create, update, delete
  data       String    @map("data") // JSON payload
  createdAt  DateTime  @default(now()) @map("created_at")
  syncedAt   DateTime? @map("synced_at")
  isSynced   Boolean   @default(false) @map("is_synced")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([isSynced])
  @@map("offline_sync_states")
}

model NASBackup {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  provider     String // webdav, s3, dropbox, onedrive
  backupPath   String    @map("backup_path")
  backupSize   BigInt    @map("backup_size")
  lastBackupAt DateTime? @map("last_backup_at")
  schedule     String    @default("daily") // daily, weekly, monthly
  isActive     Boolean   @default(true) @map("is_active")
  status       String    @default("idle") // idle, running, success, failed
  errorMessage String?   @map("error_message")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([provider])
  @@index([isActive])
  @@map("nas_backups")
}

model VaultExport {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  fileName      String    @map("file_name")
  filePath      String    @map("file_path")
  fileSize      BigInt    @map("file_size")
  exportDate    DateTime  @default(now()) @map("export_date")
  expiresAt     DateTime? @map("expires_at")
  downloadCount Int       @default(0) @map("download_count")
  isPublic      Boolean   @default(false) @map("is_public")
  accessCode    String?   @unique @map("access_code")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([accessCode])
  @@map("vault_exports")
}

model P2PSyncSession {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  sessionId   String   @unique @map("session_id")
  peerAddress String   @map("peer_address")
  peerName    String?  @map("peer_name")
  isConnected Boolean  @default(false) @map("is_connected")
  lastSeen    DateTime @default(now()) @map("last_seen")
  syncCount   Int      @default(0) @map("sync_count")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@index([isConnected])
  @@map("p2p_sync_sessions")
}

model UserWidget {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  widgetType String   @map("widget_type") // ios, android, desktop
  widgetId   String   @map("widget_id")
  widgetName String   @map("widget_name")
  config     String   @map("config") // JSON config
  isEnabled  Boolean  @default(true) @map("is_enabled")
  position   Int      @default(0) @map("position")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([widgetType])
  @@map("user_widgets")
}

model WatchComplication {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  complicationType String   @map("complication_type") // apple, wearos
  complicationId   String   @map("complication_id")
  action           String   @map("action") // audio-memo, heart-rate, coordinate, step-count
  isEnabled        Boolean  @default(true) @map("is_enabled")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([complicationType])
  @@map("watch_complications")
}

model CarIntegration {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  carType         String   @map("car_type") // apple, android
  integrationType String   @map("integration_type") // carplay, android-auto
  deviceId        String   @map("device_id")
  isEnabled       Boolean  @default(true) @map("is_enabled")
  autoPlay        Boolean  @default(false) @map("auto_play")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([carType])
  @@map("car_integrations")
}

model ClipboardSync {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  clipboardId  String   @unique @map("clipboard_id")
  dataType     String   @map("data_type") // location, photo, text
  data         String   @map("data") // JSON payload
  sourceDevice String   @map("source_device")
  expiresAt    DateTime @default(now()) @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([clipboardId])
  @@index([expiresAt])
  @@map("clipboard_syncs")
}

model DesktopApp {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  platform    String   @map("platform") // windows, macos, linux
  version     String   @map("version")
  installPath String?  @map("install_path")
  systemTray  Boolean  @default(false) @map("system_tray")
  shortcuts   String   @map("shortcuts") // JSON config for keyboard shortcuts
  autoStart   Boolean  @default(false) @map("auto_start")
  lastSync    DateTime @default(now()) @map("last_sync")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([platform])
  @@map("desktop_apps")
}

model WildernessDataSaver {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  isEnabled       Boolean   @default(false) @map("is_enabled")
  mode            String    @map("mode") // 2g, 3g, low-bandwidth
  compression     String    @map("compression") // low, medium, high
  imageQuality    String    @map("image_quality") // low, medium, high
  videoQuality    String    @map("video_quality") // low, medium, high
  vectorTiles     Boolean   @default(true) @map("vector_tiles")
  backgroundQueue Boolean   @default(true) @map("background_queue")
  dataLimit       Int?      @map("data_limit") // MB per day
  lastTriggered   DateTime? @map("last_triggered")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([isEnabled])
  @@map("wilderness_data_savers")
}

// AI Multi-agent Companion
model AIJournalEntry {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  memoryId    String?  @map("memory_id")
  date        DateTime @map("date")
  title       String
  content     String   @db.Text
  photos      String   @map("photos") // JSON array of photo URLs
  locations   String   @map("locations") // JSON array of location data
  isDraft     Boolean  @default(true) @map("is_draft")
  isReviewed  Boolean  @default(false) @map("is_reviewed")
  generatedAt DateTime @default(now()) @map("generated_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
  @@index([isDraft])
  @@map("ai_journal_entries")
}

model AIInterview {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  question    String    @db.Text
  answer      String?   @db.Text
  audioUrl    String?   @map("audio_url")
  duration    Int?
  isCompleted Boolean   @default(false) @map("is_completed")
  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isCompleted])
